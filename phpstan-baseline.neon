parameters:
	ignoreErrors:
		-
			message: '#^Using nullsafe property access "\?\-\>email" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Filament/Auth/Login.php

		-
			message: '#^Cannot access property \$serial on array\<string, mixed\>\|Illuminate\\Database\\Eloquent\\Model\.$#'
			identifier: property.nonObject
			count: 1
			path: app/Filament/Infolists/Components/ChartHistoryEntry.php

		-
			message: '#^Cannot access property \$serial on array\<string, mixed\>\|Illuminate\\Database\\Eloquent\\Model\.$#'
			identifier: property.nonObject
			count: 1
			path: app/Filament/Infolists/Components/EnergyBarEntry.php

		-
			message: '#^Call to an undefined method App\\Services\\DeviceSettingsService\:\:action\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Filament/Resources/Devices/Pages/EditDevice.php

		-
			message: '#^Call to an undefined method App\\Services\\DeviceSettingsService\:\:action\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Filament/Resources/Devices/Pages/ViewDevice.php

		-
			message: '#^Method App\\Filament\\Resources\\Devices\\Schemas\\DeviceSetup\:\:expandItem\(\) has parameter \$it with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Filament/Resources/Devices/Schemas/DeviceSetup.php

		-
			message: '#^Method App\\Filament\\Resources\\Devices\\Schemas\\DeviceSetup\:\:field\(\) has parameter \$f with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Filament/Resources/Devices/Schemas/DeviceSetup.php

		-
			message: '#^Method App\\Filament\\Resources\\Devices\\Schemas\\DeviceSetup\:\:settingsSchema\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Filament/Resources/Devices/Schemas/DeviceSetup.php

		-
			message: '#^Method App\\Filament\\Resources\\Devices\\Schemas\\DeviceSetup\:\:visible\(\) has parameter \$f with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Filament/Resources/Devices/Schemas/DeviceSetup.php

		-
			message: '#^Offset ''items'' might not exist on array\{title\: string, tabs\?\: array\<int, array\{name\: string, items\: array\}\>\|null, items\?\: array\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: app/Filament/Resources/Devices/Schemas/DeviceSetup.php

		-
			message: '#^Trait App\\Filament\\Resources\\HasHeaderFormAction is used zero times and is not analysed\.$#'
			identifier: trait.unused
			count: 1
			path: app/Filament/Resources/HasHeaderFormAction.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$serial\.$#'
			identifier: property.notFound
			count: 1
			path: app/Filament/User/Widgets/HistoryChart.php

		-
			message: '#^Method App\\Filament\\User\\Widgets\\HistoryChart\:\:getDevices\(\) return type with generic class Illuminate\\Database\\Eloquent\\Collection does not specify its types\: TKey, TModel$#'
			identifier: missingType.generics
			count: 1
			path: app/Filament/User/Widgets/HistoryChart.php

		-
			message: '#^Method App\\Filament\\User\\Widgets\\HistoryChart\:\:getListeners\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Filament/User/Widgets/HistoryChart.php

		-
			message: '#^Method App\\Models\\Device\:\:commands\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\HasMany does not specify its types\: TRelatedModel, TDeclaringModel$#'
			identifier: missingType.generics
			count: 1
			path: app/Models/Device.php

		-
			message: '#^Method App\\Models\\Device\:\:owner\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\BelongsTo does not specify its types\: TRelatedModel, TDeclaringModel$#'
			identifier: missingType.generics
			count: 1
			path: app/Models/Device.php

		-
			message: '#^Method App\\Models\\DeviceCommand\:\:device\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\BelongsTo does not specify its types\: TRelatedModel, TDeclaringModel$#'
			identifier: missingType.generics
			count: 1
			path: app/Models/DeviceCommand.php

		-
			message: '#^Method App\\Models\\DeviceCommand\:\:user\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\BelongsTo does not specify its types\: TRelatedModel, TDeclaringModel$#'
			identifier: missingType.generics
			count: 1
			path: app/Models/DeviceCommand.php

		-
			message: '#^Method App\\Models\\User\:\:devices\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\HasMany does not specify its types\: TRelatedModel, TDeclaringModel$#'
			identifier: missingType.generics
			count: 1
			path: app/Models/User.php

		-
			message: '#^Method App\\Services\\DeviceSettingsService\:\:save\(\) should return array\<int, App\\Models\\DeviceCommand\> but returns list\<Illuminate\\Database\\Eloquent\\Model\>\.$#'
			identifier: return.type
			count: 1
			path: app/Services/DeviceSettingsService.php

		-
			message: '#^Method App\\Services\\InfluxService\:\:parseEnergyCsvWithFormat\(\) has parameter \$fields with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Services/InfluxService.php

		-
			message: '#^Method App\\Services\\InfluxService\:\:parseEnergyCsvWithFormat\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Services/InfluxService.php

		-
			message: '#^Comparison operation "\>" between 1 and 1 is always false\.$#'
			identifier: greater.alwaysFalse
			count: 1
			path: app/Support/InverterSettings.php

		-
			message: '#^Method App\\Support\\InverterSettings\:\:addField\(\) has parameter \$it with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Support/InverterSettings.php

		-
			message: '#^Method App\\Support\\InverterSettings\:\:addField\(\) has parameter \$out with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Support/InverterSettings.php

		-
			message: '#^Method App\\Support\\InverterSettings\:\:addFields\(\) has parameter \$it with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Support/InverterSettings.php

		-
			message: '#^Method App\\Support\\InverterSettings\:\:addFields\(\) has parameter \$out with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Support/InverterSettings.php

		-
			message: '#^Method App\\Support\\InverterSettings\:\:clientSchemaFields\(\) has parameter \$it with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Support/InverterSettings.php

		-
			message: '#^Method App\\Support\\InverterSettings\:\:clientSchemaFields\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Support/InverterSettings.php

		-
			message: '#^Method App\\Support\\InverterSettings\:\:decode\(\) has parameter \$f with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Support/InverterSettings.php

		-
			message: '#^Method App\\Support\\InverterSettings\:\:encodeWrite\(\) has parameter \$f with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Support/InverterSettings.php

		-
			message: '#^Method App\\Support\\InverterSettings\:\:encodeWrite\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Support/InverterSettings.php

		-
			message: '#^Method App\\Support\\InverterSettings\:\:sections\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 2
			path: app/Support/InverterSettings.php

		-
			message: '#^Method App\\Support\\InverterSettings\:\:writeForField\(\) should return array\{reg\: int, value\: int, bit\?\: int, bits\?\: int\}\|null but returns array\.$#'
			identifier: return.type
			count: 1
			path: app/Support/InverterSettings.php

		-
			message: '#^Method App\\Support\\InverterSettings\:\:writesFromChanges\(\) should return array\<int, array\{reg\: int, value\: int, bit\?\: int, bits\?\: int\}\> but returns list\<array\>\.$#'
			identifier: return.type
			count: 1
			path: app/Support/InverterSettings.php

		-
			message: '#^Offset ''scale'' on non\-empty\-array on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: app/Support/InverterSettings.php

		-
			message: '#^Parameter \#2 \$string of function explode expects string, bool\|string given\.$#'
			identifier: argument.type
			count: 1
			path: config/sanctum.php
